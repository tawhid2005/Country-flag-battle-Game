# Server environment only. Never place these values in index.html.
APP_ORIGIN=https://www.countryflagbattle.xyz
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred server key from Supabase Settings > API Keys (sb_secret_...).
SUPABASE_SECRET_KEY=
# Optional legacy fallback; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random secret of at least 32 bytes. Rotation logs out existing sessions.
SESSION_SECRET=
ADMIN_USERNAME=tawhidh2005
# scrypt$SALT_HEX$HASH_HEX (see SETUP.md)
ADMIN_PASSWORD_HASH=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENV=sandbox
# JSON mapping plan IDs to ONE-TIME Polar products; no recurring products.
POLAR_PRODUCTS={"1m":"","2m":"","4m":"","8m":"","12m":"","lifetime":""}
# Optional backend only; the current public Bangladesh flow uses manual WhatsApp review.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_ENV=sandbox
